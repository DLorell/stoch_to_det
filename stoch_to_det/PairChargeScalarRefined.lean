private theorem pair_charge_from_polynomial_refined {r K t : ℝ}
    (hD : 0 < pairSecantD r)
    (hK : t^3*(pairSecantN r/pairSecantD r)-pairEntropyCostRefined t ≤ K)
    (hP : 0 ≤ pairChargePolynomialRefined t r) :
    1 ≤ (733:ℝ)/50*K + (77 : ℝ)/100*
      (pairSecantDistance r+(pairSecantDistance r)^2/4) := by
  have heq : t^3*(pairSecantN r/pairSecantD r)-pairEntropyCostRefined t =
      (t^3*pairSecantN r-pairEntropyCostRefined t*pairSecantD r)/pairSecantD r := by
    field_simp
  rw [heq] at hK
  have hmul := (div_le_iff₀ hD).mp hK
  unfold pairChargePolynomialRefined at hP
  have hh : 1*pairSecantD r ≤
      ((733:ℝ)/50*K + (77 : ℝ)/100*
        (pairSecantDistance r+(pairSecantDistance r)^2/4))*pairSecantD r := by
    nlinarith only [hmul, hP]
  exact (mul_le_mul_iff_left₀ hD).mp hh

/-- Rational entropy-floor evaluations imply the refined uniform pair charge. -/
theorem pair_charge_scalar_refined {r K : ℝ}
    (hr0 : 0 ≤ r) (hr1 : r ≤ (9 : ℝ)/50)
    (hinfo : ∀ t : ℝ, 0 < t →
      t^3*(pairSecantN r/pairSecantD r)-pairEntropyCostRefined t ≤ K) :
    1 ≤ (733:ℝ)/50*K + (77 : ℝ)/100*
      (pairSecantDistance r+(pairSecantDistance r)^2/4) := by
  have hD := pair_secant_denominator_pos hr0 hr1
  by_cases h0 : r ≤ (9 / 400)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((723 / 1000)) (by norm_num))
      (pair_charge_refined_interval_0 (by linarith) h0)
  by_cases h1 : r ≤ (27 / 800)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((709 / 1000)) (by norm_num))
      (pair_charge_refined_interval_1 (by linarith) h1)
  by_cases h2 : r ≤ (63 / 1600)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((351 / 500)) (by norm_num))
      (pair_charge_refined_interval_2 (by linarith) h2)
  by_cases h3 : r ≤ (9 / 200)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((697 / 1000)) (by norm_num))
      (pair_charge_refined_interval_3 (by linarith) h3)
  by_cases h4 : r ≤ (9 / 160)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((69 / 100)) (by norm_num))
      (pair_charge_refined_interval_4 (by linarith) h4)
  by_cases h5 : r ≤ (27 / 400)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((679 / 1000)) (by norm_num))
      (pair_charge_refined_interval_5 (by linarith) h5)
  by_cases h6 : r ≤ (9 / 100)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((331 / 500)) (by norm_num))
      (pair_charge_refined_interval_6 (by linarith) h6)
  by_cases h7 : r ≤ (27 / 200)
  · exact pair_charge_from_polynomial_refined hD (hinfo ((311 / 500)) (by norm_num))
      (pair_charge_refined_interval_7 (by linarith) h7)
  exact pair_charge_from_polynomial_refined hD (hinfo ((553 / 1000)) (by norm_num))
    (pair_charge_refined_interval_8 (by linarith) hr1)

