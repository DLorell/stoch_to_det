import stoch_to_det.PairChargeScalar

/-! Refined exact common-contact pair-charge certificates. -/
noncomputable section
namespace stoch_to_det
set_option maxRecDepth 8192
set_option maxHeartbeats 2000000

noncomputable def pairEntropyCostRefined (t : ℝ) : ℝ :=
  let v := (71 : ℝ)/250*t^6
  (589 : ℝ)/2000*t^4 + v-v^2/2+v^3/3

private def pairChargePolynomialRefined (t r : ℝ) : ℝ :=
  (733:ℝ)/50*(t^3*pairSecantN r-pairEntropyCostRefined t*pairSecantD r) +
  (77 : ℝ)/100*(pairSecantDistance r+(pairSecantDistance r)^2/4)*pairSecantD r -
  pairSecantD r

